<c:FluentWindow x:Class="MakeItColor.Views.MessageDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:MakeItColor.Controls"
                Title="MakeItColor" Width="460" SizeToContent="Height" ResizeMode="NoResize"
                WindowStartupLocation="CenterOwner" IsDialog="True" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="24,22,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:IconView x:Name="Glyph" Width="28" Height="28" Margin="0,2,16,0" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="Heading" Style="{StaticResource Text.Subtitle}" />
                <TextBlock x:Name="Message" Margin="0,10,0,0" Style="{StaticResource Text.Body}" />
                <Border x:Name="DetailsBox" Margin="0,14,0,0" MaxHeight="220" Visibility="Collapsed" Style="{StaticResource Card}" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8">
                        <TextBlock x:Name="Details" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text.Primary}" />
                    </ScrollViewer>
                </Border>
                <CheckBox x:Name="Option" Margin="0,12,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <Grid x:Name="Buttons">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PrimaryButton" Grid.Column="0" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnPrimary" />
                <Button x:Name="SecondaryButton" Grid.Column="2" Click="OnSecondary" />
                <Button x:Name="CloseButton" Grid.Column="4" IsCancel="True" Click="OnClose" />
            </Grid>
        </Border>
    </Grid>
</c:FluentWindow>
