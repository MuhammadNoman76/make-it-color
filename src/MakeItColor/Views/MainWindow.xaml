<c:FluentWindow x:Class="MakeItColor.Views.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:MakeItColor.Controls"
                xmlns:v="clr-namespace:MakeItColor.Views"
                Title="MakeItColor" Width="1200" Height="800" MinWidth="560" MinHeight="460"
                WindowStartupLocation="CenterScreen" AllowDrop="True">
    <c:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type v:WorkItem}">
            <Grid Margin="8,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="64" Height="48" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource Control.FillTertiary}">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border>
                <c:IconView Width="14" Height="14" Margin="0,0,4,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="White"
                            Data="{StaticResource Icon.Video}" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisible}}" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Status}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    <ProgressBar Height="3" Margin="0,5,0,0" Maximum="1" Value="{Binding Progress}" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </c:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Margin="24,14,18,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="DeviceChip" CornerRadius="14" Padding="10,5,12,5" VerticalAlignment="Center" BorderThickness="1"
                        Background="{DynamicResource Card.Background}" BorderBrush="{DynamicResource Card.Stroke}"
                        ToolTip="Where the colour model runs: your NPU first, then your graphics card, then your CPU">
                    <StackPanel Orientation="Horizontal">
                        <c:IconView Width="16" Height="16" Data="{StaticResource Icon.Processor}" Foreground="{DynamicResource Text.Secondary}" />
                        <TextBlock x:Name="DeviceText" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="NPU › GPU › CPU" />
                    </StackPanel>
                </Border>
                <Button Margin="6,0,0,0" Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.Settings}" ToolTip="Settings (Ctrl+,)"
                        AutomationProperties.Name="Settings" Click="OnSettings" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Width="38" Height="38" Source="{StaticResource Logo.Mark}" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="MakeItColor" />
                    <TextBlock x:Name="Tagline" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"
                               Text="Black-and-white photos and videos, in colour and restored. On your own PC." />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- a newer version is out -->
        <Border x:Name="UpdateBar" Grid.Row="1" Margin="24,0,24,10" Padding="16,10" CornerRadius="6" BorderThickness="1" Visibility="Collapsed"
                Background="{DynamicResource Status.InfoBackground}" BorderBrush="{DynamicResource Card.Stroke}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateNowButton" Height="32" Style="{StaticResource AccentButton}" Content="Update now" Click="OnUpdateNow" />
                    <Button x:Name="UpdateLaterButton" Height="32" Margin="8,0,0,0" Content="Later" Click="OnUpdateLater" />
                    <Button x:Name="UpdateSkipButton" Height="32" Margin="8,0,0,0" Style="{StaticResource SubtleButton}" Content="Skip this version" Click="OnUpdateSkip" />
                </StackPanel>
                <c:IconView DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Data="{StaticResource Icon.ArrowDownload}" Foreground="{DynamicResource Text.Accent}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateTitle" Style="{StaticResource Text.BodyStrong}" />
                    <TextBlock x:Name="UpdateNotes" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    <ProgressBar x:Name="UpdateProgress" Height="3" Margin="0,6,12,0" Maximum="1" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- home: nothing added yet -->
        <Grid x:Name="HomePanel" Grid.Row="2" Margin="24,4,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="DropZone">
                <Border x:Name="DropBack" CornerRadius="8" Background="{DynamicResource Layer.Background}" />
                <Rectangle x:Name="DropBorder" RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="5 4" SnapsToDevicePixels="True"
                           Stroke="{DynamicResource Control.StrongStroke}" Opacity="0.6" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <Image x:Name="HomeLogo" Width="96" Height="96" Source="{StaticResource Logo.Mark}" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Title}" TextAlignment="Center" TextWrapping="Wrap"
                               Text="Bring old photos and films back to colour" />
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.BodySecondary}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                               Text="Drop black-and-white photos, videos or a whole folder here, or choose them. The models run on this PC: nothing is uploaded." />
                    <WrapPanel HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Button Height="38" Style="{StaticResource AccentCommandButton}" c:Ui.Icon="{StaticResource Icon.ImageMultiple}"
                                Content="Choose photos or videos" Click="OnOpen" ToolTip="Ctrl+O" />
                        <Button Height="38" Margin="8,0,0,0" Style="{StaticResource IconTextButton}" c:Ui.Icon="{StaticResource Icon.FolderOpen}"
                                Content="Choose a folder" Click="OnOpenFolder" />
                    </WrapPanel>
                    <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" TextAlignment="Center" TextWrapping="Wrap"
                               Text="Photos: JPEG, PNG, TIFF, BMP, WebP, HEIC · Videos: MP4, MOV, MKV, AVI, WMV, WebM and more" />
                </StackPanel>
            </Grid>
            <UniformGrid x:Name="InfoCards" Grid.Row="1" Columns="3" Margin="0,14,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <DockPanel>
                        <c:IconView DockPanel.Dock="Left" Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,12,0" Data="{StaticResource Icon.Processor}" Foreground="{DynamicResource Text.Accent}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Your NPU first" />
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="Then your graphics card, then your CPU. Every chip is checked for correct colours before it's used." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <DockPanel>
                        <c:IconView DockPanel.Dock="Left" Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,12,0" Data="{StaticResource Icon.Sparkle}" Foreground="{DynamicResource Text.Accent}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Restored, not just coloured" />
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="Faded contrast fixed; blur, noise and JPEG damage taken out; small photos up to 4× larger. Videos keep their sound." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                    <DockPanel>
                        <c:IconView DockPanel.Dock="Left" Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,12,0" Data="{StaticResource Icon.ShieldLock}" Foreground="{DynamicResource Text.Accent}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Private and free" />
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="Your files never leave this PC, and the originals are never changed." />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>
        </Grid>

        <!-- work: the viewer and the list -->
        <Grid x:Name="WorkPanel" Grid.Row="2" Margin="24,4,24,18" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition x:Name="FilesColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <c:CompareView x:Name="Compare" Margin="12" />
                        <StackPanel x:Name="WorkingOverlay" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" Visibility="Collapsed">
                            <Border CornerRadius="16" Padding="14,7" Background="#C0000000">
                                <TextBlock x:Name="WorkingText" Foreground="White" FontSize="13" Text="Colouring…" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid x:Name="Toolbar" Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Two groups that wrap onto two lines when the window is narrow. -->
                    <WrapPanel x:Name="PhotoTools" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Height="36" Margin="0,0,18,0">
                            <c:IconView Width="18" Height="18" Data="{StaticResource Icon.Sparkle}" Foreground="{DynamicResource Text.Secondary}" />
                            <TextBlock Margin="8,0,10,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="Enhance" />
                            <CheckBox x:Name="EnhanceBox" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" AutomationProperties.Name="Enhance this photo"
                                      ToolTip="Sharper and cleaner: takes out blur, noise and JPEG damage (and makes small photos larger, see Settings)"
                                      Click="OnEnhanceClick" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Height="36">
                            <c:IconView Width="18" Height="18" Data="{StaticResource Icon.Color}" Foreground="{DynamicResource Text.Secondary}" ToolTip="Colour strength" />
                            <TextBlock x:Name="VividnessLabel" Margin="8,0,2,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="Colour strength" />
                            <Slider x:Name="Vividness" Width="180" Margin="8,0,0,0" Minimum="0.5" Maximum="1.5" Value="1" SmallChange="0.05" LargeChange="0.1"
                                    VerticalAlignment="Center" AutomationProperties.Name="Colour strength" ValueChanged="OnVividnessChanged" />
                            <TextBlock x:Name="VividnessText" Margin="10,0,0,0" Width="44" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="100%" />
                            <Button Style="{StaticResource LinkButton}" Padding="4" Margin="2,0,0,0" VerticalAlignment="Center" Content="Reset" Click="OnVividnessReset" ToolTip="Back to the colours the model chose" />
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel x:Name="ActionButtons" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="RetryButton" Height="36" Style="{StaticResource AccentCommandButton}" c:Ui.Icon="{StaticResource Icon.Reset}"
                                Content="Try again" Click="OnRetry" Visibility="Collapsed" />
                        <Button x:Name="CancelButton" Height="36" Style="{StaticResource IconTextButton}" c:Ui.Icon="{StaticResource Icon.Dismiss}"
                                Content="Stop" Click="OnCancel" Visibility="Collapsed" ToolTip="Stop colouring this video" />
                        <Button x:Name="ShowButton" Height="36" Margin="8,0,0,0" Style="{StaticResource IconTextButton}" c:Ui.Icon="{StaticResource Icon.FolderOpen}"
                                Content="Show in folder" Click="OnShow" Visibility="Collapsed" />
                        <Button x:Name="PlayButton" Height="36" Margin="8,0,0,0" Style="{StaticResource AccentCommandButton}" c:Ui.Icon="{StaticResource Icon.Play}"
                                Content="Play video" Click="OnPlay" Visibility="Collapsed" />
                        <Button x:Name="SaveButton" Height="36" Margin="8,0,0,0" Style="{StaticResource AccentCommandButton}" c:Ui.Icon="{StaticResource Icon.Save}"
                                Content="Save colour photo" Click="OnSave" Visibility="Collapsed" ToolTip="Ctrl+S" />
                    </StackPanel>
                </Grid>
            </Grid>

            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.Add}" ToolTip="Add photos or videos (Ctrl+O)"
                            AutomationProperties.Name="Add photos or videos" Click="OnOpen" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.BodyStrong}" Text="Your files" />
                </DockPanel>
                <Button x:Name="SaveAllButton" DockPanel.Dock="Bottom" Height="36" Margin="0,10,0,0" HorizontalAlignment="Stretch" Style="{StaticResource IconTextButton}"
                        c:Ui.Icon="{StaticResource Icon.Save}" Content="Save all colour photos…" Click="OnSaveAll" IsEnabled="False" />
                <Border Style="{StaticResource Card}" Padding="4">
                    <ListBox x:Name="List" BorderThickness="0" Background="Transparent" ItemTemplate="{StaticResource ItemTemplate}"
                             ItemContainerStyle="{StaticResource PlainListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Your files" />
                </Border>
            </DockPanel>
        </Grid>

        <!-- status bar -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}" Padding="24,7,24,8">
            <TextBlock x:Name="StatusText" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"
                       Text="Ready. Add a black-and-white photo or video to begin." />
        </Border>
    </Grid>
</c:FluentWindow>
